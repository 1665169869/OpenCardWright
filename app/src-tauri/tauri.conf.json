{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "门锁发卡台",
  "version": "1.4.0",
  "identifier": "io.opencardwright.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "门锁发卡台",
        "width": 1280,
        "height": 820,
        "minWidth": 1024,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "icon": ["icons/icon.ico"],
    "windows": {
      "wix": {
        "language": "zh-CN",
        "template": "wix/main.wxs",
        "upgradeCode": "07e67703-7451-5273-9e63-2f4716f3a875",
        "bannerPath": "icons/wix/banner.bmp",
        "dialogImagePath": "icons/wix/dialog.bmp"
      }
    },
    "resources": ["resources/device/**/*"]
  }
}
