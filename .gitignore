# ---------------- 依赖与构建产物 ----------------
node_modules/
app/node_modules/

# Rust 构建目录（本项目用 CARGO_TARGET_DIR 指到 C:\ocw-target，这里兜底）
target/
app/src-tauri/target/

# 前端构建与打包产物
app/dist/
app/release/

# 构建脚本生成的 SDK 运行副本（由 sdk/*.cs 现编，不入库）
app/src-tauri/resources/sdk/

# ---------------- 调试 / 临时 ----------------
.tmp/
app/.tmp/
*.log
*.TMP
*~RF*

# 数据库备份（现场数据不进仓库）
*.bak
*.bak-*
*.reset-bak
*.before-*.bak

# 编辑器 / 系统
.vscode/
.idea/
__pycache__/
*.pyc
Thumbs.db
desktop.ini
.DS_Store

# 本地 agent 记忆与计划（含本机绝对路径，不入库）
.ai-memory/
.workbuddy/

# IDA / 反编译产物（分析 vendor/ 里的二进制时生成，不入库）
*.i64
*.id0
*.id1
*.id2
*.nam
*.til
*.idb

# 逆向实验产物（含打过补丁的第三方 DLL、原始备份），不入库
vendor/**/接口文件-patched/
*.orig
